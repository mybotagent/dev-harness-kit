#!/usr/bin/env bash
# .githooks/pre-commit — currently a no-op.
#
# History: this hook used to auto-rewrite .github/ci-review-provider.txt
# from .env:CI_REVIEW_PROVIDER on every commit. That behavior was removed
# because it (a) silently inverted user intent — committing in a worktree
# whose provider didn't match the main checkout's .env would flip the
# tracked file with no abort and no clear failure surface, and (b) coupled
# two files with different audiences (local .env is gitignored + user-
# private; the tracked file is the contract with CI). When users reported
# "why does it keep switching to deepseek", they were right: the silent
# rewrite was the bug.
#
# New model: the tracked file is user-controlled. To switch provider,
# run `bin/set-provider.sh <minimax|anthropic|deepseek>`, review the
# diff it prints, then commit + push. CI_REVIEW_PROVIDER in .env is a
# local convenience only; it does NOT auto-propagate.
#
# Version auto-bump lives in .githooks/pre-push, not here — pre-commit
# fires on every commit (incl. amend / rebase), and bumping on each
# would generate noise. Pre-push fires once per push and compares the
# local version against origin/main, which is the correct reference for
# a release-gated branch.
#
# Activation: git config core.hooksPath .githooks (same as pre-push).

exit 0
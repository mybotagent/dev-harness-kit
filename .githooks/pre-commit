#!/usr/bin/env bash
# .githooks/pre-commit — sync .github/ci-review-provider.txt + auto-bump plugin version.
#
# Two responsibilities, run in order:
#   1. Sync .github/ci-review-provider.txt from local .env (CI_REVIEW_PROVIDER)
#      so .env stays the single source of truth.
#   2. Auto-bump .claude-plugin/plugin.json:version (PATCH++) when this commit
#      touches a skills/* SKILL.md. The PR then carries the bumped version
#      naturally; no separate bump-PR is needed. A CI "version-freshness"
#      check in .github/workflows/ci.yml enforces that PR head version > base
#      version, so stale PRs (whose base advanced after they were opened)
#      must re-commit before they can merge.
#
# Skip rules for the auto-bump:
#   - If the commit already touches .claude-plugin/plugin.json or
#     marketplace.json, the user is doing their own version edit; respect
#     their value (do not overwrite).
#   - If only files outside the plugin/skill universe changed (workflows,
#     docs, tests), no version bump — those don't ship to consumers.
#
# Activation: git config core.hooksPath .githooks (same as pre-push).

set -eo pipefail

# === 1. .env → ci-review-provider.txt sync ===
MAIN_ROOT="$(dirname "$(git rev-parse --git-common-dir)")"
ENV_FILE="$MAIN_ROOT/.env"
PROVIDER_FILE=".github/ci-review-provider.txt"

# Nothing to sync if either side is missing (e.g. not this project's layout).
if [ -f "$ENV_FILE" ] && [ -f "$PROVIDER_FILE" ]; then
  desired="$(grep -E '^CI_REVIEW_PROVIDER=' "$ENV_FILE" | tail -1 | cut -d'=' -f2- | tr -d '[:space:]')"
  case "$desired" in
      minimax|anthropic|deepseek)
          current="$(tr -d '[:space:]' < "$PROVIDER_FILE")"
          if [ "$desired" != "$current" ]; then
              echo "$desired" > "$PROVIDER_FILE"
              git add "$PROVIDER_FILE"
              echo "[pre-commit] synced $PROVIDER_FILE -> $desired (from .env CI_REVIEW_PROVIDER)"
          fi
          ;;
      "")
          # CI_REVIEW_PROVIDER not set in .env — leave the tracked file alone.
          ;;
      *)
          echo "[pre-commit] WARN: .env CI_REVIEW_PROVIDER='$desired' is not minimax/anthropic/deepseek; ignoring" >&2
          ;;
  esac
fi

# === 2. Plugin version auto-bump ===
STAGED="$(git diff --cached --name-only)"
NEEDS_BUMP=false

# If the user is editing the manifest directly, respect their version value.
# They might be hand-rolling a MINOR or MAJOR bump, or setting a tag like
# 1.0.0-rc.1 — we don't second-guess them.
if echo "$STAGED" | grep -qE '^\.claude-plugin/(plugin|marketplace)\.json$'; then
  :
else
  # Skill change → auto-bump PATCH. (A hook change or workflow tweak without
  # any skill edit is non-consumer-facing; do not bump on those.)
  if echo "$STAGED" | grep -qE '^skills/.*SKILL\.md$'; then
    NEEDS_BUMP=true
  fi
fi

if [ "$NEEDS_BUMP" = "true" ]; then
  CURRENT="$(jq -r .version .claude-plugin/plugin.json)"
  if ! [[ "$CURRENT" =~ ^([0-9]+)\.([0-9]+)\.([0-9]+)$ ]]; then
    echo "[pre-commit] ::error:: plugin.json:version=$CURRENT is not MAJOR.MINOR.PATCH" >&2
    exit 1
  fi
  MAJOR="${BASH_REMATCH[1]}"
  MINOR="${BASH_REMATCH[2]}"
  PATCH="${BASH_REMATCH[3]}"
  NEW_VERSION="${MAJOR}.${MINOR}.$((PATCH + 1))"

  jq --arg v "$NEW_VERSION" '.version = $v' .claude-plugin/plugin.json > .tmp
  mv .tmp .claude-plugin/plugin.json
  git add .claude-plugin/plugin.json
  echo "[pre-commit] auto-bumped plugin.json: $CURRENT -> $NEW_VERSION (skill change detected)"
fi

exit 0

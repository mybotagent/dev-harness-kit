#!/usr/bin/env bash
# .githooks/pre-push — Block direct push to main + auto-bump plugin version.
#
# Two responsibilities, run in order:
#   1. Block direct push to `main` (PR-only workflow policy).
#   2. Auto-bump both plugin manifests' versions (PATCH++) before pushing
#      a non-main branch, by comparing the LOCAL version against origin/main.
#      - LOCAL == MAIN: bump PATCH (BASE + 1) in both manifests, commit, push.
#      - LOCAL >  MAIN: respect the user's version and sync Codex if needed.
#      - LOCAL <  MAIN: refuse with a clear error (user must rebase first;
#        another PR merged and advanced main past this branch's tip).
#
# Why pre-push (not pre-commit): the bump is only meaningful when the
# branch is actually going to origin. Pre-commit bumps on every commit
# (including amend/rebase/SQUASH-amend dry-runs), which is noise.
# Pre-push fires once per push, comparing against origin/main which is the
# correct reference for a release-gated branch.
#
# Activation:
#   git config core.hooksPath .githooks       # local-only
#   ./lib/install.sh --setup-hooks            # install.sh 자동 호출
#
# Bypass (for maintainers ONLY with explicit —no-verify, NEVER default):
#   git push --no-verify
#
# Note: GitHub private repos without Pro cannot enforce this server-side.
# This hook is the client-side enforcement + CI will additionally gate.

set -eo pipefail

# Release manifests. Claude is the current release baseline; Codex is kept
# at the exact same version by this hook.
CLAUDE_PLUGIN=".claude-plugin/plugin.json"
CODEX_PLUGIN=".codex-plugin/plugin.json"

# jq is required for the version auto-bump (and is already a hard dep
# elsewhere: lib/ci_setup.py and version-bump.yml both call jq). Check
# upfront so a missing jq fails the hook with an actionable message
# instead of an opaque jq exit at the wrong layer.
if ! command -v jq >/dev/null 2>&1; then
  echo "[pre-push] ::error:: jq is required for plugin-version auto-bump." >&2
  echo "[pre-push] ::error:: Install:  brew install jq   |   apt install jq" >&2
  exit 1
fi

# Read push lines: <local_ref> <local_sha> <remote_ref> <remote_sha>
while read -r LOCAL_REF LOCAL_SHA REMOTE_REF REMOTE_SHA; do
    REMOTE_BRANCH="${REMOTE_REF#refs/heads/}"

    case "$REMOTE_BRANCH" in
        main|master)
            echo "[pre-push] BLOCKED: direct push to '$REMOTE_BRANCH' is disabled." >&2
            echo "" >&2
            echo "  Policy: this repo requires PR review before merge." >&2
            echo "" >&2
            echo "  Workflow:" >&2
            echo "    1. git checkout -b feat/<short-name>" >&2
            echo "    2. git push -u origin feat/<short-name>" >&2
            echo "    3. gh pr create --base main --head feat/<short-name>" >&2
            echo "    4. Wait for CI ✓ + (if reviewer assigned) approval" >&2
            echo "    5. Merge via 'gh pr merge' or GitHub UI button" >&2
            echo "" >&2
            echo "  Bypass (ONLY for emergency hotfix with explicit consent):" >&2
            echo "    git push --no-verify" >&2
            exit 1
            ;;
        "")
            # Tag push (e.g. `git push origin dev-kit--vX.Y.Z`). Skip the
            # auto-bump logic — the user is just syncing a tag, not
            # publishing a new commit.
            ;;
        *)
            # === Auto-bump plugin version against origin/main ===
            # Fetch origin/main so we can read its plugin.json:version as
            # the baseline. If the fetch fails (offline / no remote), skip
            # the bump silently — CI freshness check is the backstop.
            if ! git fetch origin main 2>/dev/null; then
              echo "[pre-push] WARN: could not fetch origin/main; skipping version bump (CI freshness is the backstop)"
            else
              MAIN_VERSION="$(git show origin/main:"$CLAUDE_PLUGIN" 2>/dev/null | jq -r .version 2>/dev/null || echo "")"
              LOCAL_VERSION="$(jq -r .version "$CLAUDE_PLUGIN")"

              if [ ! -f "$CODEX_PLUGIN" ]; then
                echo "[pre-push] ::error:: missing Codex plugin manifest: $CODEX_PLUGIN" >&2
                exit 1
              fi

              if [ -z "$MAIN_VERSION" ]; then
                echo "[pre-push] WARN: origin/main has no plugin.json:version; skipping bump"
              elif ! [[ "$MAIN_VERSION" =~ ^([0-9]+)\.([0-9]+)\.([0-9]+)$ ]]; then
                echo "[pre-push] WARN: origin/main version=$MAIN_VERSION is not MAJOR.MINOR.PATCH; skipping bump"
              elif ! [[ "$LOCAL_VERSION" =~ ^([0-9]+)\.([0-9]+)\.([0-9]+)$ ]]; then
                echo "[pre-push] ::error:: local plugin.json:version=$LOCAL_VERSION is not MAJOR.MINOR.PATCH" >&2
                exit 1
              else
                # LOCAL matched LAST, so BASH_REMATCH[1..3] hold LOCAL's
                # MAJOR / MINOR / PATCH captures (not MAIN's).
                MAJOR="${BASH_REMATCH[1]}"
                MINOR="${BASH_REMATCH[2]}"
                PATCH="${BASH_REMATCH[3]}"
                # Force base-10 interpretation: a leading-zero PATCH
                # (e.g. 0.3.099) would otherwise be parsed as octal and
                # `$((PATCH + 1))` would fail with "value too great for
                # base". `10#` is a defensive prefix; current versions
                # don't trigger this, but it costs one character.
                PATCH=$((10#$PATCH + 1))
                NEW_VERSION="${MAJOR}.${MINOR}.${PATCH}"

                # Compare using `sort -V` for version-aware ordering.
                HIGHER="$(printf '%s\n%s\n' "$MAIN_VERSION" "$LOCAL_VERSION" | sort -V | tail -1)"

                if [ "$HIGHER" = "$LOCAL_VERSION" ] && [ "$LOCAL_VERSION" != "$MAIN_VERSION" ]; then
                  # LOCAL > MAIN — user already bumped. Sync Codex if needed.
                  CODEX_VERSION="$(jq -r .version "$CODEX_PLUGIN")"
                  if [ "$CODEX_VERSION" != "$LOCAL_VERSION" ]; then
                    TMP="$(mktemp)"
                    jq --arg v "$LOCAL_VERSION" '.version = $v' "$CODEX_PLUGIN" > "$TMP"
                    mv "$TMP" "$CODEX_PLUGIN"
                    git add "$CODEX_PLUGIN"
                    git commit --no-verify -m "chore(release): sync Codex plugin to v${LOCAL_VERSION}" >/dev/null
                    echo "[pre-push] synced Codex plugin version: $CODEX_VERSION -> $LOCAL_VERSION"
                  else
                    echo "[pre-push] version $LOCAL_VERSION > main $MAIN_VERSION; OK"
                  fi
                elif [ "$LOCAL_VERSION" = "$MAIN_VERSION" ]; then
                  # LOCAL == MAIN — auto-bump PATCH in both manifests and stage.
                  TMP="$(mktemp)"
                  trap 'rm -f "$TMP"' EXIT
                  jq --arg v "$NEW_VERSION" '.version = $v' "$CLAUDE_PLUGIN" > "$TMP"
                  mv "$TMP" "$CLAUDE_PLUGIN"
                  TMP="$(mktemp)"
                  jq --arg v "$NEW_VERSION" '.version = $v' "$CODEX_PLUGIN" > "$TMP"
                  mv "$TMP" "$CODEX_PLUGIN"
                  # --no-verify: skip the user's pre-commit hook. The
                  # pre-push hook IS the source of truth for the bump; we
                  # don't want a stale pre-commit hook to bundle
                  # unrelated changes (e.g. .env → ci-review-provider.txt
                  # sync) into the bump commit.
                  git add "$CLAUDE_PLUGIN" "$CODEX_PLUGIN"
                  git commit --no-verify -m "chore(release): bump dev-kit to v${NEW_VERSION}" >/dev/null
                  echo "[pre-push] auto-bumped Claude + Codex plugin versions: $LOCAL_VERSION -> $NEW_VERSION (matches origin/main)"
                else
                  # LOCAL < MAIN — stale; refuse.
                  echo "[pre-push] ::error:: local version $LOCAL_VERSION is OLDER than origin/main $MAIN_VERSION" >&2
                  echo "[pre-push] ::error:: Another PR merged first and advanced main past this branch." >&2
                  echo "[pre-push] ::error:: Rebase onto origin/main (or fetch + rebase) and re-push." >&2
                  echo "[pre-push] ::error:: After rebase, this hook will auto-bump the next PATCH." >&2
                  exit 1
                fi
              fi
            fi
            ;;
    esac
done

exit 0

{
  "hooks": {
    "SessionStart": [
      {
        "_commands_dir_registered_by_install_commands": true,
        "hooks": [
          {
            "command": "bash \"$PWD/bin/install-commands.sh\"",
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "for i in python3 python py; do if \"$i\" -c \"\" </dev/null >/dev/null 2>&1; then \"$i\" tools/save_log.py --tool codex; exit 0; fi; done"
          }
        ],
        "_loghooks_managed": true
      }
    ]
  }
}
